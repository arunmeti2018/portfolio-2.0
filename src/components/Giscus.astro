---
// Comments coming soon - enable once arunmeti2018/comments repo is created
// Uncomment the script below and add data-repo-id + data-category-id from giscus.app
// Then remove or hide the .comments-coming-soon div
interface Props {
  mapping?: string;
}

const { mapping = "url" } = Astro.props;
void mapping;
---

<div class="giscus-wrapper">
  <!-- Coming soon placeholder - replace with giscus div when repo is ready -->
  <!-- <div class="giscus"></div> -->
  <div class="comments-coming-soon">
    <span class="comments-icon">💬</span>
    <p class="comments-message">Comments coming soon</p>
    <p class="comments-subtext">
      Discussion will be enabled once the comments repo is set up.
    </p>
  </div>
</div>

<!-- Giscus script - uncomment when arunmeti2018/comments repo is created and add correct repo-id + category-id from giscus.app
<script is:inline define:vars={{ mapping }}>
  function loadGiscus() {
    const container = document.querySelector(".giscus");
    if (!container) return;

    container.innerHTML = "";

    const savedTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
    const theme = savedTheme || systemTheme;

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "arunmeti2018/comments");
    script.setAttribute("data-repo-id", "R_kgDOQ90dlg");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDOQ90dls4C1NXa");
    script.setAttribute("data-mapping", mapping);
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "top");
    script.setAttribute("data-theme", theme);
    script.setAttribute("data-lang", "en");
    script.setAttribute("data-loading", "lazy");
    script.crossOrigin = "anonymous";
    script.async = true;

    container.appendChild(script);
  }

  function updateGiscusTheme() {
    const iframe = document.querySelector("iframe.giscus-frame");
    if (!iframe) return;

    const theme = document.documentElement.getAttribute("data-theme") || "dark";

    iframe.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: theme } } },
      "https://giscus.app",
    );
  }

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "data-theme"
      ) {
        updateGiscusTheme();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  loadGiscus();
  document.addEventListener("astro:page-load", loadGiscus);
  document.addEventListener("astro:after-swap", loadGiscus);
</script>
-->

<style>
  .giscus-wrapper {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-border) / 0.3);
  }

  .comments-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    padding: 2rem;
    text-align: center;
    border-radius: 0.5rem;
    background-color: rgb(var(--color-card) / 0.5);
  }

  .comments-icon {
    font-size: 1.5rem;
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }

  .comments-message {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgb(var(--color-text-base));
  }

  .comments-subtext {
    font-size: 0.8rem;
    color: rgb(var(--color-text-base) / 0.6);
    margin-top: 0.25rem;
  }
</style>
