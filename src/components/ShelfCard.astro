---
import {
  getCoverGradient,
  SHELF_STATUS,
  SHELF_TYPE,
  type ShelfType,
} from "@utils/shelf";
import { formatYear } from "@utils/formatYear";

export interface Props {
  type: ShelfType;
  title: string;
  creator: string;
  genre: string;
  status: string;
  rating?: number;
  year?: number;
  description?: string;
  compact?: boolean;
  href?: string;
  poster?: string;
}

const {
  type,
  title,
  creator,
  status,
  rating,
  year,
  description,
  compact = false,
  href,
  poster,
} = Astro.props;

const gradient = getCoverGradient(title);
const statusInfo = SHELF_STATUS[status as keyof typeof SHELF_STATUS] || {
  label: status,
  color: "#999",
};
const typeInfo = SHELF_TYPE[type] || {
  label: type,
  icon: "",
};
const Tag = href ? "a" : "div";
---

<Tag
  class:list={[
    "shelf-card group block w-full transition-all duration-300",
    compact ? "flex flex-col" : "flex flex-col gap-2.5",
  ]}
  data-status={status}
  data-type={type}
  {...href ? { href } : {}}
>
  {/* ===== POSTER / COVER CONTAINER ===== */}
  <div
    class="shelf-cover-container relative w-full aspect-[2/3] rounded-xl overflow-hidden shadow-sm border border-skin-line/15 bg-skin-card transition-all duration-300 group-hover:shadow-md group-hover:border-skin-line/35 group-hover:-translate-y-1"
  >
    {/* Base Background Gradient Fallback */}
    <div class="absolute inset-0" style={`background: ${gradient}`} />

    {/* Poster Image */}
    {
      poster && (
        <img
          src={poster}
          alt={`${title} poster`}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          loading="lazy"
        />
      )
    }

    {/* Top Badges */}
    <div class="absolute top-2 left-2 right-2 flex items-center justify-between z-10 pointer-events-none">
      {/* Type badge with icon */}
      <div
        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md backdrop-blur-md text-[9px] font-mono uppercase tracking-wider font-medium text-white shadow-sm"
        style="background: rgba(0, 0, 0, 0.55);"
      >
        <span class="w-2.5 h-2.5 shelf-icon" set:html={typeInfo.icon} />
        <span>{typeInfo.label}</span>
      </div>

      {/* Rating badge */}
      {
        rating !== undefined && (
          <div
            class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md backdrop-blur-md text-[9px] font-mono font-semibold text-amber-300 shadow-sm"
            style="background: rgba(0, 0, 0, 0.55);"
          >
            <span>★</span>
            <span>{rating}</span>
          </div>
        )
      }
    </div>

    {/* If no poster image, show elegant typographic cover */}
    {
      !poster && (
        <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center z-10 bg-gradient-to-t from-black/60 via-transparent to-black/30">
          <h3 class="text-white font-serif text-sm sm:text-base font-medium leading-snug drop-shadow-md">
            {title}
          </h3>
          <p class="text-white/60 text-xs font-serif italic mt-1 truncate max-w-full">
            {creator}
          </p>
        </div>
      )
    }

    {/* Status badge at bottom right for non-compact */}
    {
      !compact && status !== "done" && (
        <div class="absolute bottom-2 right-2 z-10">
          <span
            class="px-2 py-0.5 text-[9px] font-mono uppercase tracking-wider rounded-md font-medium backdrop-blur-md shadow-sm"
            style={`background: rgba(0,0,0,0.6); color: ${statusInfo.color}`}
          >
            {statusInfo.label}
          </span>
        </div>
      )
    }

    {/* Subtle gradient vignette at bottom */}
    <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-black/40 to-transparent pointer-events-none" />
  </div>

  {/* ===== CARD DETAILS (ALWAYS VISIBLE ON MOBILE & DESKTOP) ===== */}
  <div class="pt-2 px-0.5 flex flex-col">
    <h3
      class:list={[
        "font-serif font-medium text-skin-base leading-snug transition-colors group-hover:text-skin-accent",
        compact ? "text-xs sm:text-sm line-clamp-1" : "text-sm sm:text-base line-clamp-1",
      ]}
    >
      {title}
    </h3>

    <div class="flex items-center justify-between gap-2 mt-0.5">
      <p class="text-[11px] sm:text-xs text-skin-base/60 font-serif italic truncate">
        {creator}
      </p>
      {
        year && (
          <span class="text-[10px] font-mono text-skin-base/40 shrink-0">
            {formatYear(year)}
          </span>
        )
      }
    </div>

    {
      !compact && description && (
        <p class="text-xs text-skin-base/60 leading-relaxed line-clamp-2 mt-1.5 font-sans font-normal">
          {description}
        </p>
      )
    }
  </div>
</Tag>
