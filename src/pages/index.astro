---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import {
  TbArrowDown,
  TbArrowRight,
  TbBrandGithub,
  TbExternalLink,
} from "react-icons/tb";
import HeroBackground from "@components/HeroBackground";
import ClimbingBackToTop from "@components/ClimbingBackToTop.astro";
import ScrollReveal from "@components/ScrollReveal";
import SpotlightCard from "@components/SpotlightCard";
import { getAllPosts, getPostUrl, getPostTopic } from "@utils/collections";
import ShelfCard from "@components/ShelfCard.astro";
import { getCollection } from "astro:content";
import { withBase } from "@utils/base";
import { stripExt } from "@utils/shelf";
import { slugifyStr } from "@utils/slugify";
import digitalClosetImg from "@assets/images/digital-closet.png";
import disasterMgmtImg from "@assets/images/disaster-management.png";
import snakeGameImg from "@assets/images/snake-game.png";

const allPosts = await getAllPosts();
const sortedPosts = getSortedPosts(allPosts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const allShelf = await getCollection("shelf");
const shelfDone = allShelf
  .filter((i) => i.data.status === "done" && i.data.featured !== false)
  .sort((a, b) => {
    const aPin = a.data.pinned || a.data.featured ? 1 : 0;
    const bPin = b.data.pinned || b.data.featured ? 1 : 0;
    return bPin - aPin;
  })
  .slice(0, 6);
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = allProjects.slice(0, 3);
---

<Layout>
  <Header />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* ===== HERO ===== */}
    <section
      class="min-h-[75svh] flex flex-col justify-center relative border-x border-skin-line/10 mt-20 sm:mt-8 mb-6 overflow-hidden rounded-sm"
    >
      <div class="absolute inset-0 -z-10 bg-skin-fill/50">
        <HeroBackground client:load />
      </div>

      <div
        class="absolute top-0 left-0 w-8 h-8 border-t border-l border-skin-text-base/30"
      >
      </div>
      <div
        class="absolute top-0 right-0 w-8 h-8 border-t border-r border-skin-text-base/30"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-8 h-8 border-b border-l border-skin-text-base/30"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-skin-text-base/30"
      >
      </div>

      <div
        class="absolute top-0 left-0 w-full flex justify-between items-start p-6 font-mono text-[10px] uppercase tracking-widest text-skin-base/50"
      >
        <div class="flex flex-col gap-1">
          <span>Building things that work</span>
        </div>
        <div class="text-right flex flex-col gap-1">
          <span>Available for collaboration</span>
        </div>
      </div>

      <div
        class="relative z-10 w-full max-w-4xl mx-auto px-6 py-16 sm:py-20 flex flex-col items-center text-center"
      >
        <div
          class="inline-flex items-center gap-3 px-3 py-1 border border-skin-line/30 rounded-full bg-skin-fill/80 backdrop-blur-sm mb-8"
        >
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-skin-base/70"
            >Human who actually thinks!</span
          >
        </div>

        <h1
          class="flex flex-col items-center justify-center font-serif text-6xl sm:text-8xl lg:text-9xl leading-[0.85] text-skin-base tracking-tighter"
        >
          <span class="relative">
            ARUN
            <span class="absolute top-1/2 left-0 w-full h-[1px] bg-skin-line/0"
            ></span>
          </span>
          <span
            class="text-skin-base/20 font-sans font-bold tracking-tight italic"
            style="-webkit-text-stroke: 1px rgba(var(--color-text-base), 0.3); color: transparent;"
          >
            METI
          </span>
        </h1>

        <p
          class="mt-8 max-w-xl text-sm sm:text-base font-normal leading-relaxed text-skin-base/90 bg-skin-fill/60 backdrop-blur-sm p-4 border border-skin-line/10 rounded-sm"
        >
          Engineer by day, explorer by default. Currently figuring out what's next —
          one iconic thing at a time. Certified cinephile.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-6">
          <LinkButton
            href={withBase("/projects")}
            className="px-8 py-3 bg-skin-inverted text-skin-inverted hover:bg-skin-accent hover:text-skin-inverted transition-colors font-mono text-xs uppercase tracking-widest rounded-sm"
          >
            View Projects
          </LinkButton>

          <div class="h-[1px] w-12 bg-skin-line/30 hidden sm:block"></div>
          <div class="scale-90 opacity-70 hover:opacity-100 transition-opacity">
            <Socials />
          </div>
        </div>
      </div>
    </section>

    {/* ===== 1. FEATURED BLOG POSTS (BELOW HERO) ===== */}
    {
      featuredPosts.length > 0 && (
        <section class="pt-8 pb-10 sm:pt-10 sm:pb-12 border-b border-skin-line/15">
          <ScrollReveal client:visible>
            <div class="flex items-end justify-between mb-6 border-b border-skin-line/20 pb-3">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-widest text-skin-base/40 block mb-1">
                  Selected Writing
                </span>
                <h2 class="font-serif text-2xl sm:text-3xl text-skin-base">
                  Featured Posts
                </h2>
              </div>
              <a
                href={withBase("/blog")}
                class="group inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-skin-base/60 hover:text-skin-base transition-colors"
              >
                <span>All Posts</span>
                <TbArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </ScrollReveal>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredPosts.slice(0, 4).map((post, index) => (
              <ScrollReveal client:visible delay={index * 0.08}>
                <a
                  href={withBase(getPostUrl(post))}
                  class="group flex flex-col justify-between h-full p-6 sm:p-7 rounded-md border border-skin-line/15 hover:border-skin-line/35 bg-skin-card/25 hover:bg-skin-card/50 backdrop-blur-sm transition-all duration-300 hover:shadow-lg hover:shadow-skin-accent/5 overflow-hidden"
                >
                  <div>
                    <div class="flex items-center gap-3 mb-3">
                      <span
                        class="w-2 h-2 rounded-full"
                        style={`background-color: rgb(var(--color-collection-${getPostTopic(post)}))`}
                      />
                      <span
                        class="font-mono text-[10px] uppercase tracking-widest font-semibold"
                        style={`color: rgb(var(--color-collection-${getPostTopic(post)}))`}
                      >
                        {getPostTopic(post)}
                      </span>
                      <span class="font-mono text-[10px] text-skin-base/40">
                        {post.data.pubDatetime.toLocaleDateString("en-US", {
                          month: "short",
                          day: "2-digit",
                          year: "numeric",
                        })}
                      </span>
                    </div>

                    <h3 class="font-serif text-xl sm:text-2xl text-skin-base leading-snug mb-3 group-hover:text-skin-accent transition-colors duration-300">
                      {post.data.title}
                    </h3>

                    <p class="text-sm text-skin-base/70 leading-relaxed line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="pt-4 border-t border-skin-line/10 flex items-center justify-between gap-3">
                    <div class="flex flex-wrap gap-1.5">
                      {post.data.tags?.slice(0, 3).map((tag: string) => (
                        <span class="px-2 py-0.5 text-[9px] font-mono uppercase tracking-wider rounded border border-skin-line/15 bg-skin-card-muted/60 text-skin-base/60">
                          #{tag}
                        </span>
                      ))}
                    </div>
                    <span class="inline-flex items-center gap-1 text-xs font-mono uppercase tracking-widest text-skin-base/40 group-hover:text-skin-base/80 transition-colors shrink-0">
                      <span>Read</span>
                      <TbArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                    </span>
                  </div>
                </a>
              </ScrollReveal>
            ))}
          </div>
        </section>
      )
    }

    {/* ===== 2. FEATURED PROJECTS (BELOW FEATURED BLOG POSTS) ===== */}
    {
      featuredProjects.length > 0 && (
        <section class="pt-8 pb-10 sm:pt-10 sm:pb-12 border-b border-skin-line/15">
          <ScrollReveal client:visible>
            <div class="flex items-end justify-between mb-6 border-b border-skin-line/20 pb-3">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-widest text-skin-base/40 block mb-1">
                  Selected Works
                </span>
                <h2 class="font-serif text-2xl sm:text-3xl text-skin-base">
                  Featured Projects
                </h2>
              </div>
              <a
                href={withBase("/projects")}
                class="group inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-skin-base/60 hover:text-skin-base transition-colors"
              >
                <span>All Projects</span>
                <TbArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </ScrollReveal>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
            {featuredProjects.map((project, idx) => {
              const slug = slugifyStr(project.data.title);
              const thumbnailMap = {
                "Digital Closet": digitalClosetImg,
                "Disaster Management System": disasterMgmtImg,
                "Snake Game": snakeGameImg,
              };
              const thumb =
                thumbnailMap[project.data.title as keyof typeof thumbnailMap] ||
                null;

              return (
                <ScrollReveal client:visible delay={idx * 0.08}>
                  <div class="group relative flex flex-col h-full border border-skin-line/15 rounded-md hover:border-skin-line/40 bg-skin-card/25 hover:bg-skin-card/50 backdrop-blur-sm transition-all duration-300 hover:shadow-lg overflow-hidden">
                    <a
                      href={withBase(`/projects/${slug}/`)}
                      class="block aspect-[16/10] overflow-hidden bg-skin-card-muted/40 border-b border-skin-line/10 relative"
                    >
                      {thumb ? (
                        <img
                          src={thumb.src}
                          alt={project.data.title}
                          class="w-full h-full object-cover rounded transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center font-serif text-3xl text-skin-accent/30 font-bold">
                          {project.data.title.charAt(0)}
                        </div>
                      )}
                    </a>

                    <div class="p-5 flex flex-col flex-1 justify-between gap-4">
                      <div>
                        <div class="flex items-start justify-between gap-2 mb-2">
                          <a
                            href={withBase(`/projects/${slug}/`)}
                            class="group/title inline-block"
                          >
                            <h3 class="font-serif text-lg font-bold text-skin-base group-hover/title:text-skin-accent transition-colors leading-snug">
                              {project.data.title}
                            </h3>
                          </a>
                          <div class="flex items-center gap-1.5 shrink-0">
                            {project.data.githubLink && (
                              <a
                                href={project.data.githubLink}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="p-1.5 rounded-md border border-skin-line/15 text-skin-base/50 hover:text-skin-base hover:border-skin-base/40 transition-all"
                                aria-label={`${project.data.title} GitHub`}
                              >
                                <TbBrandGithub className="w-3.5 h-3.5" />
                              </a>
                            )}
                            {project.data.liveLink && (
                              <a
                                href={project.data.liveLink}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="p-1.5 rounded-md border border-skin-line/15 text-skin-base/50 hover:text-skin-base hover:border-skin-base/40 transition-all"
                                aria-label={`${project.data.title} Live`}
                              >
                                <TbExternalLink className="w-3.5 h-3.5" />
                              </a>
                            )}
                          </div>
                        </div>
                        <p class="text-xs text-skin-base/70 leading-relaxed line-clamp-2">
                          {project.data.description}
                        </p>
                      </div>

                      <div class="pt-3 border-t border-skin-line/10 flex flex-wrap gap-1">
                        {project.data.techStack
                          .slice(0, 3)
                          .map((tech: string) => (
                            <span class="px-2 py-0.5 text-[9px] font-mono uppercase tracking-wider rounded border border-skin-line/15 bg-skin-card-muted/50 text-skin-base/60">
                              {tech}
                            </span>
                          ))}
                        {project.data.techStack.length > 3 && (
                          <span class="px-1.5 py-0.5 text-[9px] font-mono text-skin-base/40">
                            +{project.data.techStack.length - 3}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </ScrollReveal>
              );
            })}
          </div>
        </section>
      )
    }

    {/* ===== 3. RECENT POSTS & CONTACT ===== */}
    <section
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 border-b border-skin-line/15 pt-8 pb-10 sm:pt-10 sm:pb-12"
    >
      <div class="lg:col-span-7 corner-brackets relative">
        <ScrollReveal client:visible delay={0.1}>
          <div
            class="flex items-center justify-between mb-8 border-b border-skin-line/20 pb-3"
          >
            <span
              class="font-mono text-[10px] uppercase tracking-widest text-skin-base/40"
              >Recent Thoughts</span
            >
            <a
              href={withBase("/blog/")}
              class="group inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-widest text-skin-base/50 hover:text-skin-base transition-colors"
            >
              All Posts <TbArrowRight
                className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"
              />
            </a>
          </div>
        </ScrollReveal>

        <ul class="space-y-6">
          {
            recentPosts.slice(0, 4).map((post, index) => (
              <li class="block">
                <ScrollReveal client:visible delay={index * 0.08}>
                  <a
                    href={withBase(getPostUrl(post))}
                    class="group block p-4 rounded-md border border-skin-line/10 hover:border-skin-line/30 hover:bg-skin-card/20 transition-all duration-300"
                  >
                    <div class="flex items-center gap-3 mb-1.5">
                      <span
                        class="w-1.5 h-1.5 rounded-full"
                        style={`background-color: rgb(var(--color-collection-${getPostTopic(post)}))`}
                      />
                      <span
                        class="font-mono text-[10px] uppercase tracking-widest"
                        style={`color: rgb(var(--color-collection-${getPostTopic(post)}))`}
                      >
                        {getPostTopic(post)}
                      </span>
                      <span class="font-mono text-[10px] text-skin-base/40 group-hover:text-skin-base transition-colors">
                        {post.data.pubDatetime.toLocaleDateString("en-US", {
                          month: "short",
                          day: "2-digit",
                          year: "numeric",
                        })}
                      </span>
                    </div>
                    <h4 class="font-serif text-xl sm:text-2xl text-skin-base group-hover:text-skin-accent transition-colors">
                      {post.data.title}
                    </h4>
                  </a>
                </ScrollReveal>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-5">
        <ScrollReveal client:visible delay={0.2}>
          <SpotlightCard
            client:visible
            className="flex flex-col justify-between bg-skin-card-muted/25 p-7 sm:p-8 rounded-md border border-skin-line/15 h-full backdrop-blur-sm"
          >
            <div>
              <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-skin-line/20 bg-skin-fill/60 text-[10px] font-mono uppercase tracking-widest text-skin-base/70 mb-4"
              >
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                <span>Open for collaboration</span>
              </div>
              <h3 class="font-serif text-3xl mb-3 text-skin-base">
                Get in Touch
              </h3>
              <p class="text-sm font-normal text-skin-base/75 leading-relaxed">
                Have a question, an opportunity, or want to discuss systems
                architecture? Feel free to reach out directly.
              </p>
            </div>

            <div class="flex flex-col gap-3 mt-10">
              <LinkButton
                href={withBase("/resume")}
                className="flex items-center justify-between w-full px-5 py-3.5 border border-skin-line/40 hover:bg-skin-inverted hover:text-skin-inverted hover:border-skin-inverted transition-all duration-300 rounded-sm group"
              >
                <span class="text-xs font-mono uppercase tracking-widest"
                  >View Resume</span
                >
                <TbArrowDown
                  className="w-4 h-4 group-hover:translate-y-1 transition-transform"
                />
              </LinkButton>

              <a
                href="mailto:arunameti2024@gmail.com"
                class="flex items-center justify-center gap-2 px-5 py-3 border border-skin-line/20 hover:border-skin-base/40 text-xs font-mono uppercase tracking-widest text-skin-base/70 hover:text-skin-base rounded-sm transition-all"
              >
                arunameti2024@gmail.com
              </a>
            </div>
          </SpotlightCard>
        </ScrollReveal>
      </div>
    </section>

    {/* ===== 4. THE SHELF ===== */}
    <section class="py-14 sm:py-16">
      <ScrollReveal client:visible>
        <div class="flex items-end justify-between mb-8">
          <div>
            <span
              class="font-mono text-[10px] uppercase tracking-widest text-skin-base/35 block mb-1"
              >Currently exploring</span
            >
            <h2 class="font-serif text-2xl sm:text-3xl text-skin-base">
              The Shelf
            </h2>
          </div>
          <a
            href={withBase("/shelf/")}
            class="font-mono text-[10px] uppercase tracking-widest text-skin-base/50 hover:text-skin-base transition-colors"
            >View all →</a
          >
        </div>
      </ScrollReveal>

      <ScrollReveal client:visible delay={0.1}>
        <div
          class="flex gap-3 overflow-x-auto pb-3 snap-x snap-mandatory scrollbar-hide md:grid md:grid-cols-6 md:overflow-visible md:pb-0"
        >
          {
            shelfDone.map((item) => (
              <div class="shrink-0 w-[130px] snap-start md:w-auto md:shrink">
                <ShelfCard
                  type={item.data.type}
                  title={item.data.title}
                  creator={item.data.creator}
                  genre={item.data.genre}
                  status={item.data.status}
                  rating={item.data.rating}
                  poster={item.data.poster}
                  compact
                  href={withBase(`/shelf/${stripExt(item.id)}/`)}
                />
              </div>
            ))
          }
        </div>
      </ScrollReveal>
    </section>
  </main>
  <ClimbingBackToTop />
  <Footer />
</Layout>
