---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ClimbingBackToTop from "@components/ClimbingBackToTop.astro";
import ScrollReveal from "@components/ScrollReveal";
import { SITE } from "@config";
import { withBase } from "@utils/base";
import { TbArrowRight, TbCode, TbMovie, TbBrain } from "react-icons/tb";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Learn more about Arun Meti — software engineer, systems builder, and creative thinker."
  ogImage="/about/og.png"
>
  <Header activeNav="about" />

  <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 pt-24 sm:pt-28 pb-16">
    {/* ===== HERO PROFILE CARD ===== */}
    <section
      class="relative border border-skin-line/15 rounded-2xl p-6 sm:p-10 bg-skin-card/40 backdrop-blur-md shadow-sm overflow-hidden"
    >
      {/* Decorative subtle ambient glow */}
      <div
        class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-skin-accent/5 blur-3xl pointer-events-none"
      ></div>

      <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
        {/* Avatar with status indicator */}
        <div class="relative shrink-0 mx-auto sm:mx-0">
          <div
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden border border-skin-line/25 shadow-md bg-skin-card"
          >
            <img
              src={withBase("/assets/luffy.png")}
              alt="Arun Meti"
              class="w-full h-full object-cover"
            />
          </div>
          <div
            class="absolute -bottom-1 -right-1 flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-skin-card border border-skin-line/20 shadow-sm"
            title="Available"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[9px] font-mono uppercase tracking-wider text-skin-base/70">Active</span>
          </div>
        </div>

        {/* Info */}
        <div class="flex-1 w-full text-center sm:text-left">
          <div class="inline-flex items-center gap-2 mb-2">
            <span
              class="px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-widest bg-skin-inverted text-skin-inverted font-medium"
            >
              Engineer
            </span>
            <span class="text-skin-base/30 text-xs">/</span>
            <span class="text-xs font-mono text-skin-base/60">Ittiam Systems</span>
          </div>

          <h1
            class="font-serif text-3xl sm:text-4xl lg:text-5xl text-skin-base leading-tight mb-3"
          >
            Arun Meti
          </h1>

          <p class="text-sm sm:text-base text-skin-base/75 leading-relaxed mb-6 font-normal">
            Software Engineer at <strong>Ittiam Systems</strong> and UVCE Computer Science graduate.
            Previously DevOps Intern at <strong>Syncron</strong> and UVCE Placement Coordinator.
            Focused on backend architecture, cloud infrastructure, and building resilient systems that actually hold up in production.
          </p>

          {/* Quick Technical Matrix */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-skin-base/75 mb-6 text-left">
            <div class="p-3 rounded-lg border border-skin-line/10 bg-skin-fill/50">
              <span class="font-mono text-[10px] uppercase tracking-wider text-skin-base/40 block mb-1">Languages</span>
              <span class="font-mono text-xs text-skin-base/85 font-medium">C, C++, JavaScript, Python, HTML/CSS, EJS</span>
            </div>
            <div class="p-3 rounded-lg border border-skin-line/10 bg-skin-fill/50">
              <span class="font-mono text-[10px] uppercase tracking-wider text-skin-base/40 block mb-1">Backend & Data</span>
              <span class="font-mono text-xs text-skin-base/85 font-medium">Node.js, Express, MongoDB, MySQL, Firebase, REST</span>
            </div>
            <div class="p-3 rounded-lg border border-skin-line/10 bg-skin-fill/50">
              <span class="font-mono text-[10px] uppercase tracking-wider text-skin-base/40 block mb-1">Tools & DevOps</span>
              <span class="font-mono text-xs text-skin-base/85 font-medium">Git, GitHub, Docker, Linux, Postman API, VS Code</span>
            </div>
            <div class="p-3 rounded-lg border border-skin-line/10 bg-skin-fill/50">
              <span class="font-mono text-[10px] uppercase tracking-wider text-skin-base/40 block mb-1">Core Fundamentals</span>
              <span class="font-mono text-xs text-skin-base/85 font-medium">DSA, OOPs, DBMS, Operating Systems, Networks</span>
            </div>
          </div>

          {/* Action CTAs */}
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
            <a
              href={withBase("/resume/")}
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-skin-inverted text-skin-inverted hover:bg-skin-accent transition-all font-mono text-xs uppercase tracking-widest rounded-lg shadow-sm"
            >
              Resume
            </a>
            <a
              href="mailto:arunameti2024@gmail.com"
              class="inline-flex items-center gap-2 px-5 py-2.5 border border-skin-line/30 hover:border-skin-base/60 text-skin-base/80 hover:text-skin-base hover:bg-skin-card transition-all font-mono text-xs uppercase tracking-widest rounded-lg"
            >
              Get in Touch
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ===== INTERESTS & CURATIONS ===== */}
    <section class="w-full mt-12 sm:mt-16">
      <ScrollReveal client:visible>
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="font-serif text-xl sm:text-2xl text-skin-base">What I Care About</h2>
          <span class="font-mono text-[10px] uppercase tracking-widest text-skin-base/40">Explorations</span>
        </div>
      </ScrollReveal>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {/* Tech Card */}
        <ScrollReveal client:visible delay={0.05}>
          <a
            href={withBase("/tech/")}
            class="group flex flex-col justify-between h-full p-5 sm:p-6 rounded-xl border border-skin-line/15 bg-skin-card/30 hover:bg-skin-card/70 hover:border-skin-line/30 hover:shadow-sm transition-all duration-300"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span
                    class="w-2.5 h-2.5 rounded-full"
                    style="background: rgb(var(--color-collection-tech))"
                  ></span>
                  <span
                    class="font-mono text-xs uppercase tracking-widest font-medium"
                    style="color: rgb(var(--color-collection-tech))"
                  >
                    Tech
                  </span>
                </div>
                <TbCode className="w-4 h-4 text-skin-base/30 group-hover:text-skin-base/70 transition-colors" />
              </div>
              <p class="text-xs sm:text-sm text-skin-base/60 leading-relaxed font-normal">
                Open-source software, high-performance computing, cloud architectures, and the craft of reliable engineering.
              </p>
            </div>
            <span
              class="mt-5 inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-widest text-skin-base/40 group-hover:text-skin-base transition-colors"
            >
              Explore Tech <TbArrowRight className="w-3 h-3 group-hover:translate-x-1 transition-transform" />
            </span>
          </a>
        </ScrollReveal>

        {/* Cinema Card */}
        <ScrollReveal client:visible delay={0.1}>
          <a
            href={withBase("/cinema/")}
            class="group flex flex-col justify-between h-full p-5 sm:p-6 rounded-xl border border-skin-line/15 bg-skin-card/30 hover:bg-skin-card/70 hover:border-skin-line/30 hover:shadow-sm transition-all duration-300"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span
                    class="w-2.5 h-2.5 rounded-full"
                    style="background: rgb(var(--color-collection-cinema))"
                  ></span>
                  <span
                    class="font-mono text-xs uppercase tracking-widest font-medium"
                    style="color: rgb(var(--color-collection-cinema))"
                  >
                    Cinema
                  </span>
                </div>
                <TbMovie className="w-4 h-4 text-skin-base/30 group-hover:text-skin-base/70 transition-colors" />
              </div>
              <p class="text-xs sm:text-sm text-skin-base/60 leading-relaxed font-normal">
                Films as philosophy, the poetry of visual framing, storytelling craft, and scenes that refuse to leave your memory.
              </p>
            </div>
            <span
              class="mt-5 inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-widest text-skin-base/40 group-hover:text-skin-base transition-colors"
            >
              Explore Cinema <TbArrowRight className="w-3 h-3 group-hover:translate-x-1 transition-transform" />
            </span>
          </a>
        </ScrollReveal>

        {/* Philosophy Card */}
        <ScrollReveal client:visible delay={0.15}>
          <a
            href={withBase("/philosophy/")}
            class="group flex flex-col justify-between h-full p-5 sm:p-6 rounded-xl border border-skin-line/15 bg-skin-card/30 hover:bg-skin-card/70 hover:border-skin-line/30 hover:shadow-sm transition-all duration-300"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span
                    class="w-2.5 h-2.5 rounded-full"
                    style="background: rgb(var(--color-collection-philosophy))"
                  ></span>
                  <span
                    class="font-mono text-xs uppercase tracking-widest font-medium"
                    style="color: rgb(var(--color-collection-philosophy))"
                  >
                    Philosophy
                  </span>
                </div>
                <TbBrain className="w-4 h-4 text-skin-base/30 group-hover:text-skin-base/70 transition-colors" />
              </div>
              <p class="text-xs sm:text-sm text-skin-base/60 leading-relaxed font-normal">
                Questions that refuse to settle — ethics, metaphysics, consciousness, and what it means to live thoughtfully.
              </p>
            </div>
            <span
              class="mt-5 inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-widest text-skin-base/40 group-hover:text-skin-base transition-colors"
            >
              Explore Philosophy <TbArrowRight className="w-3 h-3 group-hover:translate-x-1 transition-transform" />
            </span>
          </a>
        </ScrollReveal>
      </div>
    </section>

  </main>

  <ClimbingBackToTop />
  <Footer />
</Layout>
