---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { TbBrandGithub, TbExternalLink, TbArrowRight } from "react-icons/tb";
import ClimbingBackToTop from "@components/ClimbingBackToTop.astro";
import ScrollReveal from "@components/ScrollReveal";
import { getCollection } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { withBase } from "@utils/base";
import digitalClosetImg from "@assets/images/digital-closet.png";
import disasterMgmtImg from "@assets/images/disaster-management.png";
import snakeGameImg from "@assets/images/snake-game.png";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = projects.sort((a, b) => {
  const aDate = new Date(a.data.pubDatetime);
  const bDate = new Date(b.data.pubDatetime);
  return bDate.getTime() - aDate.getTime();
});
---

<Layout
  title={`Projects | ${SITE.title}`}
  description="Web applications and projects by Arun Meti"
  ogImage="/projects/og.png"
>
  <Header activeNav="projects" />

  <main id="main-content" class="px-4 sm:px-6">
    {/* ===== HEADER ===== */}
    <section class="max-w-5xl mx-auto pt-24 sm:pt-20 pb-10">
      <ScrollReveal client:visible>
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-skin-base/40 mb-4 block"
          >Things I've Built</span
        >
        <h1
          class="font-serif text-3xl sm:text-4xl lg:text-5xl text-skin-base leading-tight mb-3"
        >
          Projects
        </h1>
        <p
          class="text-sm sm:text-base text-skin-base/60 leading-relaxed max-w-xl"
        >
          Web applications, systems, and open-source tools — from full-stack
          platforms to real-time applications. Click on any project to explore
          its architecture and implementation.
        </p>
      </ScrollReveal>
    </section>

    {/* ===== PROJECT LIST ===== */}
    <section class="max-w-5xl mx-auto pb-16">
      <div class="flex flex-col gap-8">
        {
          sortedProjects.map((project, i) => {
            const slug = slugifyStr(project.data.title);
            const { title, description, techStack, liveLink, githubLink } =
              project.data;

            // Map project titles to their thumbnail images
            const thumbnailMap = {
              "Digital Closet": digitalClosetImg,
              "Disaster Management System": disasterMgmtImg,
              "Snake Game": snakeGameImg,
            };

            const thumbnail =
              thumbnailMap[title as keyof typeof thumbnailMap] || null;

            return (
              <ScrollReveal client:visible delay={0.05 * i}>
                <article class="group relative flex flex-col md:flex-row border border-skin-line/15 rounded-md hover:border-skin-line/40 bg-skin-card/25 hover:bg-skin-card/50 transition-all duration-300 hover:shadow-xl hover:shadow-skin-accent/5 overflow-hidden">
                  {/* Thumbnail area */}
                  <div class="w-full md:w-80 lg:w-96 shrink-0 aspect-[16/10] md:aspect-auto md:min-h-[220px] bg-skin-card-muted/40 border-b md:border-b-0 md:border-r border-skin-line/10 relative overflow-hidden flex items-center justify-center p-3 sm:p-4">
                    <a
                      href={withBase(`/projects/${slug}/`)}
                      class="block w-full h-full relative overflow-hidden rounded group-hover:opacity-95 transition-opacity"
                    >
                      {thumbnail ? (
                        <img
                          src={thumbnail.src}
                          alt={title}
                          class="w-full h-full object-contain sm:object-cover rounded transition-transform duration-500 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-skin-accent/10 to-skin-accent/5 font-serif text-4xl font-bold text-skin-accent/40">
                          {title.charAt(0)}
                        </div>
                      )}
                    </a>
                  </div>

                  {/* Content area */}
                  <div class="flex-1 p-5 sm:p-6 md:p-7 flex flex-col justify-between min-w-0 gap-4">
                    <div>
                      <div class="flex items-start justify-between gap-4 mb-2.5">
                        <a
                          href={withBase(`/projects/${slug}/`)}
                          class="group/title inline-block"
                        >
                          <h2 class="font-serif text-xl sm:text-2xl font-bold text-skin-base group-hover/title:text-skin-accent transition-colors leading-snug">
                            {title}
                          </h2>
                        </a>

                        {/* Action buttons */}
                        <div class="flex items-center gap-2 shrink-0">
                          {githubLink && (
                            <a
                              href={githubLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="p-2 rounded-md border border-skin-line/20 text-skin-base/60 hover:text-skin-base hover:border-skin-base/40 hover:bg-skin-fill/80 transition-all"
                              title="View Source on GitHub"
                              aria-label={`View ${title} source code on GitHub`}
                            >
                              <TbBrandGithub className="w-4 h-4" />
                            </a>
                          )}
                          {liveLink && (
                            <a
                              href={liveLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="p-2 rounded-md border border-skin-line/20 text-skin-base/60 hover:text-skin-base hover:border-skin-base/40 hover:bg-skin-fill/80 transition-all"
                              title="Live Demo"
                              aria-label={`Open ${title} live demo`}
                            >
                              <TbExternalLink className="w-4 h-4" />
                            </a>
                          )}
                        </div>
                      </div>

                      <p class="text-sm text-skin-base/70 leading-relaxed line-clamp-3">
                        {description}
                      </p>
                    </div>

                    {/* Footer / Tech stack & details link */}
                    <div class="pt-4 border-t border-skin-line/10 flex flex-wrap items-center justify-between gap-3">
                      <div class="flex flex-wrap gap-1.5">
                        {techStack &&
                          techStack.map((tech: string) => (
                            <span class="inline-flex items-center px-2.5 py-0.5 text-[9px] sm:text-[10px] font-mono uppercase tracking-wider rounded border border-skin-line/15 bg-skin-card-muted/60 text-skin-base/70">
                              {tech}
                            </span>
                          ))}
                      </div>

                      <a
                        href={withBase(`/projects/${slug}/`)}
                        class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-skin-base/60 group-hover:text-skin-accent transition-colors shrink-0"
                      >
                        <span>Details</span>
                        <TbArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                      </a>
                    </div>
                  </div>
                </article>
              </ScrollReveal>
            );
          })
        }
      </div>
    </section>
  </main>
  <ClimbingBackToTop />
  <Footer />
</Layout>
